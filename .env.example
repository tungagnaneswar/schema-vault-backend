# Copy this file to .env and fill in real values before running

# ── Database ──────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/schema_vault_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me

# ── JWT ───────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
APP_JWT_SECRET=change_me_use_openssl_rand_hex_32
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# ── Encryption ────────────────────────────────────────────────────────
# Must be exactly 32 characters for AES-256
APP_ENCRYPTION_KEY=change_me_32_char_key___________
